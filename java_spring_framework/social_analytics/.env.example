# cp .env.example .env
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL - dùng chung cho app và docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_analytics
DB_USERNAME=social
DB_PASSWORD=social
DB_ROOT_PASSWORD=root
DB_POOL_SIZE=10

# Thư mục ghi file log (profile prod)
LOG_PATH=logs
